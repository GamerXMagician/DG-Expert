# -----------------------------------------------------------------------------
# DG Expert — environment configuration
# Copy this file to `.env` and fill in your own Supabase project values.
# NEVER commit `.env`. NEVER put a service_role key here — this file is bundled
# into the frontend build and everything in it is PUBLIC.
# -----------------------------------------------------------------------------

# Your Supabase project URL, e.g. https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_URL=YOUR_SUPABASE_URL

# The Supabase *publishable* (a.k.a. anon) key. This is safe for the browser —
# it only grants the access your Row Level Security policies allow.
# Prefer the new publishable key format (sb_publishable_...) when available.
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY

# -----------------------------------------------------------------------------
# AI provider (OPTIONAL for local dev).
# The AI key must live ONLY in a serverless / edge function, never in the
# frontend. See supabase/functions/ask-dg-expert and README §"Connect an AI
# provider". Set this in your Supabase Edge Function secrets, NOT in this file:
#   supabase secrets set OPENAI_API_KEY=sk-...
# -----------------------------------------------------------------------------
